#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)
#include <stdio.h>

int main(void)
{
    char str[20];
    int i = 0;

    printf("문자열을 입력하시오 :");

    while (1) {
        scanf("%c", &str[i]);

        if (str[i] == '\n') {
            str[i] = '\0';
            break;
        }

        i++;
    }

    printf("문자열: %s\n", str);

    return 0;
}
