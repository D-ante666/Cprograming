#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)
#include <stdio.h>

int main() {
    char str = '\0';

    while (1) {
        printf("문자입력:");
        scanf(" %c", &str);

        if (str == 'q' || str == 'Q') break;

        printf("입력된 문자는 %c\n", str);
    }
}
